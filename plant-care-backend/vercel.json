{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/"
    },
    {
      "src": "/api-docs",
      "dest": "/"
    },
    {
      "src": "/api-docs/(.*)",
      "dest": "/"
    }
  ]
} 