{
  "version": 2,
  "buildCommand": "cd plant-care-backend && npm install && npm run build",
  "installCommand": "cd plant-care-backend && npm install",
  "outputDirectory": "plant-care-backend/dist",
  "builds": [
    {
      "src": "plant-care-backend/package.json",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "plant-care-backend/dist/index.js"
    }
  ]
} 